{
  "name": "dsgn-tweaks",
  "version": "0.1.0",
  "description": "A dev-only design panel for Next.js + Tailwind v4 pages: edit text, inspect and restyle elements, swap layouts and tokens live, then send the batch to your coding agent to implement.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheStevenShyaka/dsgn-tweaks.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "files": [
    "src",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "example": "pnpm --filter dsgn-tweaks-example dev"
  },
  "peerDependencies": {
    "lucide-react": ">=0.460.0",
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5"
  }
}
