{
  "name": "dsgn-tweaks",
  "version": "0.2.0",
  "description": "A dev-only design panel for any website: edit text, inspect and restyle elements, swap layouts and colour tokens live, then send the batch to your coding agent to implement. Plain HTML, Vite, React, Next.js and more.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheStevenShyaka/dsgn-tweaks.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./global": "./dist/dsgn-tweaks.global.js"
  },
  "bin": {
    "dsgn-tweaks": "./dist/cli.js"
  },
  "jsdelivr": "./dist/dsgn-tweaks.global.js",
  "unpkg": "./dist/dsgn-tweaks.global.js",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build:css": "tailwindcss -i src/panel/panel.css -o src/panel/panel.generated.css --minify",
    "build": "pnpm build:css && tsup",
    "typecheck": "pnpm build:css && tsc --noEmit",
    "example:html": "pnpm --filter dsgn-tweaks-example-html dev",
    "example:vite": "pnpm --filter dsgn-tweaks-example-vite dev",
    "example:next": "pnpm --filter dsgn-tweaks-example-next dev"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "lucide-preact": "^1.52.0",
    "next": "16.2.9",
    "preact": "^11.0.0",
    "react": "19.2.4",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite": "^8.3.3"
  }
}
